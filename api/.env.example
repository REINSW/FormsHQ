# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.YOUR_PROJECT@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# ── Form.io ───────────────────────────────────────────────────────────────────
FORMIO_BASE_URL=https://your-project.form.io
FORMIO_API_KEY=your-formio-api-key

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=FormsHQ <noreply@reinsw.com.au>

# ── SMS (Twilio) ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SENDER_ID=FormsHQ

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3002

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
